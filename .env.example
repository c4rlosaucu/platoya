# Copia las variables del server a server/.env y completa los valores vacíos.
# Copia solo NEXT_PUBLIC_API_URL a web/.env.local.
# Este archivo no lleva secretos. No pongas aquí la URI real, el JWT ni las claves de PayPal.

PORT=3001
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD

# En Windows, 127.0.0.1 evita que localhost resuelva a IPv6 mientras la API escucha en 0.0.0.0.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
